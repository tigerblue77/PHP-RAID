<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    bootstrap="./vendor/autoload.php"
    colors="true"
    processIsolation="false"
    stopOnFailure="false"
    syntaxCheck="false">
    <php>
        <!-- The human-readable sizes come from CakePHP's Number, whose plural
             forms and number formatting follow the intl default locale, and
             that is otherwise whatever LANG says: 0 renders "0 Byte" under
             fr_FR and "0 Bytes" under en_US or C. Pinned, so the suite means
             the same thing on every machine, CI included, and in the English
             the library's strings and README are written in. -->
        <ini name="intl.default_locale" value="en_US"/>
    </php>
    <testsuites>
        <testsuite name="Library">
            <directory>./tests</directory>
        </testsuite>
    </testsuites>
    <filter>
        <whitelist>
            <directory suffix=".php">./src/</directory>
        </whitelist>
    </filter>
    <logging>
        <log target="./build/coverage" type="coverage-html"/>
        <log type="coverage-html" target="./build/coverage/html"/>
        <log type="coverage-clover" target="./build/coverage/clover.xml"/>
    </logging>
</phpunit>
